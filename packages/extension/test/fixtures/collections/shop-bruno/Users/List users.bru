meta {
  name: List users
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/users?page=1
  body: none
  auth: inherit
}

params:query {
  page: 1
}

example {
  name: Page 1

  request: {
    url: {{baseUrl}}/users?page=1
    method: get
    mode: none
    params:query: {
      page: 1
    }
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        [{"id":1,"name":"Sara"},{"id":2,"name":"Omar"}]
      '''
    }
  }
}

example {
  name: Page 2

  request: {
    url: {{baseUrl}}/users?page=2
    method: get
    mode: none
    params:query: {
      page: 2
    }
  }

  response: {
    headers: {
      Content-Type: application/json; charset=utf-8
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        []
      '''
    }
  }
}
